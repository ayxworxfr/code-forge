/**
 * {{ table.tableComment or table.tableName }} 类型定义
 * 
 * @author {{ global.author }}
 * @date {{ global.date }}
 */
export interface {{ table.shortClassName }} {
  {%- for column in table.columns %}
  /**
   * {{ column.columnComment or column.columnName }}
   */
  {{ column.tsField }}: {{ column.tsType }};
  {%- endfor %}
}

/**
 * {{ table.tableComment or table.tableName }} 查询参数
 */
export interface {{ table.shortClassName }}Query {
  {%- for column in table.columns %}
  {%- if not column.isPrimaryKey %}
  {{ column.tsField }}?: {{ column.tsType }};
  {%- endif %}
  {%- endfor %}
  current?: number;
  size?: number;
}

/**
 * {{ table.tableComment or table.tableName }} 表单数据
 */
export interface {{ table.shortClassName }}Form {
  {%- for column in table.columns %}
  {%- if not column.isPrimaryKey or not column.isAutoIncrement %}
  {{ column.tsField }}?: {{ column.tsType }};
  {%- endif %}
  {%- endfor %}
}

/**
 * 分页响应数据
 */
export interface PageResult<T> {
  records: T[];
  total: number;
  size: number;
  current: number;
  pages: number;
}
